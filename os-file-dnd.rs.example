use gpui::{
    App, Bounds, Context, DragMoveEvent, ExternalPaths, Window, WindowBounds, WindowOptions,
    div, prelude::*, px, rgb, size,
};
use gpui_platform::application;
use std::path::PathBuf;

struct Gallery {
    files: Vec<PathBuf>,
    is_dragging: bool,
}

impl Render for Gallery {
    fn render(&mut self, _window: &mut Window, cx: &mut Context<Self>) -> impl IntoElement {
        div()
            .size_full()
            .flex()
            .flex_col()
            .bg(rgb(0x1a1a2e))
            .border_2()
            .border_color(if self.is_dragging {
                rgb(0x6366f1)
            } else {
                rgb(0x2d2d2d)
            })
            .on_drag_move::<ExternalPaths>(cx.listener(
                |this, _: &DragMoveEvent<ExternalPaths>, _window, cx| {
                    if !this.is_dragging {
                        this.is_dragging = true;
                        cx.notify();
                    }
                },
            ))
            .on_drop(cx.listener(|this, paths: &ExternalPaths, _window, cx| {
                this.is_dragging = false;
                for path in paths.paths() {
                    this.files.push(path.clone());
                }
                cx.notify();
            }))
            .child(if self.files.is_empty() {
                div()
                    .size_full()
                    .flex()
                    .items_center()
                    .justify_center()
                    .child(
                        div()
                            .text_color(if self.is_dragging {
                                rgb(0xa5b4fc)
                            } else {
                                rgb(0x6b7280)
                            })
                            .child(if self.is_dragging {
                                "Release to add files"
                            } else {
                                "Drop files here"
                            }),
                    )
            } else {
                div()
                    .size_full()
                    .p_4()
                    .flex()
                    .flex_wrap()
                    .gap_3()
                    .children(self.files.iter().map(|path| {
                        let name = path
                            .file_name()
                            .map(|n| n.to_string_lossy().into_owned())
                            .unwrap_or_default();
                        div()
                            .w_32()
                            .h_32()
                            .bg(rgb(0x2d2d2d))
                            .rounded_lg()
                            .flex()
                            .flex_col()
                            .items_center()
                            .justify_center()
                            .gap_2()
                            .child(div().text_2xl().child("🖼"))
                            .child(div().text_xs().text_color(rgb(0x9ca3af)).child(name))
                    }))
            })
    }
}

fn run_example() {
    application().run(|cx: &mut App| {
        let bounds = Bounds::centered(None, size(px(900.), px(650.)), cx);
        cx.open_window(
            WindowOptions {
                window_bounds: Some(WindowBounds::Windowed(bounds)),
                ..Default::default()
            },
            |_, cx| {
                cx.new(|_| Gallery {
                    files: Vec::new(),
                    is_dragging: false,
                })
            },
        )
        .unwrap();
        cx.activate(true);
    });
}

fn main() {
    run_example();
}
